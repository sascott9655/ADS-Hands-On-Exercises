FP = t1[1,2]
FN = t1[2,1]
TP = t1[2,2]
#total actually positive
TAP <- TP + FN
#total actually negative
TAN <- FP + TN
TPP <- FP + TP
TPN <- FN + TN
accuracy <- (TN + TP) / (TN + FP + FN + TP)
error_rate <- 1 - accuracy
sensitivity <- TP / TAP
specificity <- TN / TAN
precision <- TP / TPP
recall <- sensitivity
f1 <- 2* (precision * recall) / (precision + recall)
f2 <- 5 * (precision * recall) / ((4 * precision) + recall)
